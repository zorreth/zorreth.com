<script>
  import { CustomCursor } from 'mouse-animations';

  let cursor: CustomCursor | null = null;

  function renderCursor() {
    if (window.innerWidth < 768) return;

    const isDark = document.documentElement.classList.contains('dark');
    const themeColor = isDark ? '#ffffff' : '#000000';

    if (cursor) {
      cursor.destroy();
    }

    cursor = new CustomCursor({
      innerSize: 6,
      outerSize: 36,
      smoothness: 0.15,
      innerColor: themeColor,
      outerColor: themeColor,
    });
  }

  renderCursor();

  window.addEventListener('themechange', renderCursor);
</script>
