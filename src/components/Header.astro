---
import ThemeToggle from './ThemeToggle.astro';
import { ChevronRight } from '@lucide/astro';

const navLinks = [
  {
    name: 'About',
    href: '#about',
  },
  {
    name: 'Projects',
    href: '#projects',
  },
  {
    name: 'Contact',
    href: '#contact',
  },
];
---

<header class="flex items-center justify-between md:justify-center gap-4 m-4">
  <ThemeToggle />

  <nav
    class="bg-neutral-400/60 dark:bg-neutral-600/60 transition duration-500 p-2 rounded-full flex gap-2"
  >
    {
      navLinks.map(({ name, href }) => (
        <a
          href={href}
          class="transition duration-500 hover:bg-neutral-200 hover:text-black rounded-full py-2 px-4"
          data-nav-link
        >
          {name}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  function updateLinkState() {
    if (window.scrollY < window.innerHeight) {
      navLinks[0].classList.add('bg-neutral-200', 'text-black');
    }
  }

  updateLinkState();
  document.addEventListener('scroll', updateLinkState);
</script>
