---
import Layout from '../layouts/Layout.astro';

const donationAddress = 'UQBO8_Di1JEOQRxE2t-Wjy4QNF5cHg-bRnrlAmVUBLlrZPVC';

const links = [
  { name: 'Telegram', url: 'https://t.me/zorreth' },
  { name: 'GitHub', url: 'https://github.com/zorreth' },
  { name: 'Discord', url: 'https://discord.com/users/1006899291824078858' },
];
---

<Layout title="zorreth">
  <main>
    <h1>ZRTH</h1>

    <hr />

    <div class="links">
      {links.map((link) => <a href={link.url}>{link.name}</a>)}
    </div>

    <footer>
      <span>&copy; 2026 <b>Kirill Siukhin</b> aka <b>zorreth</b></span>
      <span>
        Donate: <b class="address" title="Copy" data-address={donationAddress}>{donationAddress}</b> (TON)
      </span>
    </footer>
  </main>
</Layout>

<script>
  const addressText: HTMLSpanElement | null = document.querySelector('.address');

  addressText?.addEventListener('click', () => {
    const address = addressText.dataset.address;

    if (address) {
      navigator.clipboard.writeText(address);
      addressText.innerText = 'Copied! <3';

      setTimeout(() => {
        addressText.innerText = address;
      }, 1500);
    }
  });
</script>

<style>
  main {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }

  h1 {
    font-size: 48px;
    font-weight: 600;
    letter-spacing: 2px;
    text-shadow: 0 0 8px var(--color-text);
  }

  hr {
    width: 100%;
    border: 1px solid var(--color-bg-light);
  }

  .links {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
  }

  a {
    color: var(--color-text);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    font-weight: 600;
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12px;
    text-align: center;
  }

  .address {
    white-space: nowrap;
    cursor: pointer;
  }
</style>
