---
import Layout from '../layouts/Layout.astro';

const donationAddress = 'UQBO8_Di1JEOQRxE2t-Wjy4QNF5cHg-bRnrlAmVUBLlrZPVC';

const links = [
  { name: 'Telegram', url: 'https://t.me/zorreth' },
  { name: 'GitHub', url: 'https://github.com/zorreth' },
  { name: 'Discord', url: 'https://discord.com/users/1006899291824078858' },
];

const projects = [
  {
    name: 'cube.zorreth.com (in-dev)',
    description: 'Speedcubing timer, social platform and progress tracker',
    repo: 'https://github.com/zorreth/cube',
    url: 'https://cube.zorreth.com',
  },
];
---

<Layout title="zorreth">
  <main>
    <h1>ZRTH</h1>

    <hr />

    <div class="links">
      {links.map(({ name, url }) => <a href={url}>{name}</a>)}
    </div>

    <section>
      <h2>Projects</h2>
      {
        projects.map(({ name, description, repo, url }) => (
          <span>
            {url ? (
              <a href={url} target="_blank">
                <b>{name}</b>
              </a>
            ) : (
              <b>{name}</b>
            )}{' '}
            {repo && <a href={repo}>[repo]</a>} – {description}
          </span>
        ))
      }
    </section>

    <section>
      <h2>Donate</h2>
      <span>
        TON: <b class="address" title="Copy" data-address={donationAddress}>{donationAddress}</b>
      </span>
    </section>

    <footer>
      &copy; 2026 <b>Kirill Siukhin</b> (aka <b>zorreth</b>)
    </footer>
  </main>
</Layout>

<script>
  const addressText: HTMLSpanElement | null = document.querySelector('.address');

  addressText?.addEventListener('click', () => {
    const address = addressText.dataset.address;

    if (address) {
      navigator.clipboard.writeText(address);
      addressText.innerText = 'Copied! <3';

      setTimeout(() => {
        addressText.innerText = address;
      }, 1500);
    }
  });
</script>

<style>
  main {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    height: 100%;
  }

  h1 {
    font-size: 48px;
    font-weight: 600;
    letter-spacing: 2px;
    text-shadow: 0 0 8px var(--color-text);
  }

  hr {
    width: 100%;
    border: 1px solid var(--color-bg-light);
  }

  .links {
    display: flex;
    gap: 12px;
    margin-bottom: 32px;
  }

  section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: center;
    margin: 0 12px 32px 12px;
  }
  section:last-of-type {
    margin-bottom: 64px;
  }

  a {
    color: var(--color-text);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    font-weight: 600;
  }

  footer {
    font-size: 14px;
    text-align: center;
  }

  .address {
    white-space: nowrap;
    cursor: pointer;
  }

  @media screen and (max-width: 500px) {
    .address {
      font-size: 12px;
    }
  }
</style>
