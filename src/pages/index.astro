---
import Layout from '../layouts/Layout.astro';
import { ChevronRight, Moon, Sun } from '@lucide/astro';

const navLinks = [
  {
    name: 'About',
    href: '#about',
  },
  {
    name: 'Projects',
    href: '#projects',
  },
  {
    name: 'Music',
    href: '#music',
  },
];
---

<Layout title="zorreth">
  <div id="tsparticles"></div>

  <main class="transition duration-500 ease-in-out">
    <header class="flex items-center justify-center gap-4 mt-4">
      <button
        class="bg-neutral-400/60 dark:bg-neutral-600/60 transition duration-500 hover:scale-105 active:scale-95 p-4 rounded-full group"
        data-theme-button
      >
        <Moon class="hidden dark:block fill-white" />
        <Sun class="block dark:hidden fill-white" />
      </button>

      <nav
        class="bg-neutral-400/60 dark:bg-neutral-600/60 transition duration-500 p-2 rounded-full flex gap-2"
      >
        {
          navLinks.map(({ name, href }) => (
            <a
              href={href}
              class="transition duration-500 hover:bg-neutral-200 hover:text-black rounded-full py-2 px-4"
            >
              {name}
            </a>
          ))
        }
      </nav>

      <a
        href="#contact"
        class="hidden md:flex items-center transition duration-500 bg-neutral-400/60 dark:bg-neutral-600/60 hover:scale-105 active:scale-95 gap-2 w-fit p-4 px-6 rounded-full"
      >
        Contact Me <ChevronRight />
      </a>
    </header>

    <div class="container mx-auto my-32" id="about">
      <h1
        class="text-black dark:text-white font-bold text-4xl transition-colors p-4 rounded-full mb-4"
      >
        Hi, my name is Kirill!
      </h1>
      <p
        class="text-black dark:text-white font-bold text-xl transition-colors p-4 rounded-full mb-4"
      >
        I am a full-stack developer, photographer, speedcuber, and musician.
      </p>
    </div>
  </main>
</Layout>

<script>
  import { tsParticles, type ILoadParams } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';
  import { CustomCursor } from 'mouse-animations';

  await loadSlim(tsParticles);

  function getParticleOptions(color: string): ILoadParams {
    return {
      id: 'tsparticles',
      options: {
        fpsLimit: 60,
        fullScreen: {
          enable: true,
          zIndex: -1,
        },
        particles: {
          paint: { fill: { color: { value: color } } },
          number: { value: 80, density: { enable: true } },
          shape: { type: 'circle' },
          opacity: { value: { min: 0.1, max: 0.6 } },
          size: { value: { min: 1, max: 4 } },
          links: {
            enable: true,
            distance: 150,
            opacity: 0.4,
            width: 1,
            color: color,
          },
          move: {
            enable: true,
            speed: 0.3,
            direction: 'none',
            random: true,
            outModes: { default: 'bounce' },
          },
        },
        interactivity: {
          events: {
            onHover: {
              enable: true,
              mode: ['bubble', 'slow', 'grab'],
            },
          },
          modes: {
            bubble: {
              distance: 200,
              size: 6,
              opacity: 1,
              duration: 2,
              mix: false,
            },
            slow: {
              factor: 0.5,
              radius: 200,
            },
            grab: {
              distance: 200,
              links: {
                enable: true,
                opacity: 0.6,
                width: 1,
                color: color,
              },
            },
          },
        },
      },
    };
  }

  const isDark = document.documentElement.classList.contains('dark');
  const initialThemeColor = isDark ? '#ffffff' : '#000000';

  let particlesInstance = await tsParticles.load(getParticleOptions(initialThemeColor));

  let cursor: CustomCursor | null = null;

  if (window.innerWidth > 768) {
    cursor = new CustomCursor({
      innerSize: 6,
      outerSize: 36,
      smoothness: 0.15,
      innerColor: initialThemeColor,
      outerColor: initialThemeColor,
    });
  }

  const main = document.querySelector('main');
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-button]');

  themeButton?.addEventListener('click', async () => {
    main?.classList.add('blur-md', 'opacity-70', 'scale-95');

    const isDarkNow = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDarkNow ? 'dark' : 'light');

    const newColor = isDarkNow ? '#ffffff' : '#000000';

    if (particlesInstance) {
      particlesInstance.destroy();
      particlesInstance = await tsParticles.load(getParticleOptions(newColor));
    }

    if (cursor) {
      cursor.destroy();

      cursor = new CustomCursor({
        innerSize: 6,
        outerSize: 36,
        smoothness: 0.15,
        innerColor: newColor,
        outerColor: newColor,
      });
    }

    requestAnimationFrame(() => {
      setTimeout(() => {
        main?.classList.remove('blur-md', 'opacity-70', 'scale-95');
      }, 300);
    });
  });
</script>
