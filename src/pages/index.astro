---
import Layout from '../layouts/Layout.astro';

const links = [
  {
    name: 'About',
    href: '#about',
  },
  {
    name: 'Development',
    href: '#development',
  },
  {
    name: 'Photography',
    href: '#photography',
  },
  {
    name: 'Speedcubing',
    href: '#speedcubing',
  },
  {
    name: 'Music',
    href: '#music',
  },
];
---

<Layout title="zorreth">
  <div id="tsparticles"></div>

  <nav class="fixed left-1/2 -translate-x-1/2 top-4 bg-neutral-900/50 p-2 rounded-full flex gap-2">
    {
      links.map(({ name, href }) => (
        <a href={href} class="hover:bg-cyan-200/50 transition-colors rounded-full py-2 px-4">
          {name}
        </a>
      ))
    }
  </nav>

  <div class="container mx-auto my-48" id="about">
    <h1 class="font-bold text-4xl bg-neutral-900/50 w-fit p-4 rounded-full mb-8">
      Hi! My name is Kirill.
    </h1>
    <span class="font-bold text-xl bg-neutral-900/50 p-4 rounded-full"
      >I am a full-stack developer, photographer, speedcuber, and musician.</span
    >
  </div>
</Layout>

<script>
  import { loadAmbientPreset } from '@tsparticles/preset-ambient';
  import { tsParticles } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';

  await loadAmbientPreset(tsParticles);
  await loadSlim(tsParticles);

  await tsParticles.load({
    id: 'tsparticles',
    options: {
      preset: 'ambient',
      fullScreen: {
        enable: true,
        zIndex: -1,
      },
      interactivity: {
        events: {
          onHover: {
            enable: true,
            mode: ['bubble', 'slow', 'grab'],
          },
        },
        modes: {
          bubble: {
            distance: 200,
            size: 6,
            opacity: 1,
            duration: 2,
            mix: false,
          },
          slow: {
            factor: 3,
            radius: 200,
          },
          grab: {
            distance: 200,
            links: {
              opacity: 0.1,
              color: '#ffffff',
              width: 1,
            },
          },
        },
      },
    },
  });
</script>
