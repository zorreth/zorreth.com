---
import Layout from '../layouts/Layout.astro';
import Particles from '../components/Particles.astro';
import CustomCursor from '../components/CustomCursor.astro';
import Header from '../components/Header.astro';
---

<Layout title="zorreth">
  <Particles />
  <CustomCursor />

  <main class="transition duration-500 ease-in-out blur-md scale-90">
    <Header />

    <div class="container mx-auto my-32" id="about">
      <h1
        class="text-black dark:text-white font-bold text-4xl transition-colors p-4 rounded-full mb-4"
      >
        Hi, my name is Kirill!
      </h1>
      <p
        class="text-black dark:text-white font-bold text-xl transition-colors p-4 rounded-full mb-4"
      >
        I am a full-stack developer, photographer, speedcuber, and musician.
      </p>
    </div>
  </main>
</Layout>

<script>
  const main = document.querySelector('main');

  window.addEventListener('themechange', () => {
    main?.classList.add('blur-md', 'opacity-70', 'scale-95');

    setTimeout(() => {
      main?.classList.remove('blur-md', 'opacity-70', 'scale-95');
    }, 300);
  });

  main?.classList.remove('blur-md', 'scale-90');
</script>
