---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import AnimatedGradient from '../components/AnimatedGradient.astro';

import TelegramIcon from '../components/icons/TelegramIcon.astro';
import DiscordIcon from '../components/icons/DiscordIcon.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';

const links = [
  {
    name: 'Telegram',
    href: 'https://t.me/zorreth',
    bg: '#0088cc',
    fg: '#fff',
    icon: TelegramIcon,
  },
  {
    name: 'Discord',
    href: 'https://discord.com/users/1006899291824078858',
    bg: '#5865f2',
    fg: '#fff',
    icon: DiscordIcon,
  },
  {
    name: 'GitHub',
    href: 'https://github.com/zorreth',
    bg: '#000',
    fg: '#fff',
    icon: GitHubIcon,
  },
];

const projects = [
  {
    name: 'zorreth.com',
    description: 'The personal website you are visiting right now',
    links: [{ name: 'GitHub', href: 'https://github.com/zorreth/zorreth.github.io' }],
    tags: ['astro'],
  },
  {
    name: 'balabol.cc',
    description: 'The easiest social landing page hosting and link shortener',
    links: [{ name: 'GitHub', href: 'https://github.com/zorreth/balabol.cc' }],
    tags: ['nextjs', 'hono', 'drizzle', 'postgres'],
  },
  {
    name: 'Cubean',
    description: 'Speedcubing timer, social platform and progress tracker',
    links: [{ name: 'GitHub', href: 'https://github.com/zorreth/cubean' }],
    tags: ['nextjs', 'shadcn-ui', 'fastify', 'drizzle', 'postgres'],
  },
  {
    name: 'Space',
    description: 'The infinite pixel art canvas',
    links: [{ name: 'GitHub', href: 'https://github.com/zorreth/space' }],
    tags: ['rust', 'axum', 'sqlx', 'postgres'],
  },
  {
    name: 'Cheburek',
    description: 'Text generation bot for the Discord servers',
    links: [{ name: 'GitHub', href: 'https://github.com/zorreth/cheburek' }],
    tags: ['discord.js', 'sqlite'],
  },
  {
    name: 'Eloquent',
    description: 'Minecraft mod that gives every mob a unique AI identity, memory, and voice',
    links: [{ name: 'GitHub', href: 'https://github.com/zorreth/eloquent' }],
    tags: ['fabric'],
  },
];
---

<Layout title="zorreth">
  <AnimatedGradient>
    <header class="container mx-auto flex justify-between items-center p-4">
      <a href="/" class="transition hover:scale-105 active:scale-95 text-5xl font-display">
        zorreth
      </a>
      <ThemeToggle />
    </header>

    <main class="transition duration-500 ease-in-out flex flex-col">
      <section class="container mx-auto my-12 text-center" id="about">
        <h1
          class="text-neutral-800 dark:text-white font-bold text-2xl md:text-4xl transition-colors p-4"
        >
          Hi there! My name is Kirill
        </h1>
        <p class="text-neutral-800 dark:text-white text-xl transition-colors p-4">
          I enjoy development, music, speedcubing and photography
        </p>
      </section>

      <section class="flex flex-col items-center mb-16 gap-4">
        {
          links.map((link) => {
            const Icon = link.icon;

            return (
              <a
                href={link.href}
                style={`background-color: ${link.bg}; color: ${link.fg};`}
                class="relative text-center text-neutral-800 p-3 rounded-full w-80 font-bold transition shadow hover:scale-105 active:scale-95"
              >
                <Icon class="absolute" />
                {link.name}
              </a>
            );
          })
        }
      </section>

      <section class="flex flex-col items-center gap-4 mb-24">
        <h2 class="font-bold text-3xl">Projects</h2>

        <div class="container px-4 grid lg:grid-cols-2 xl:grid-cols-3 gap-4">
          {
            projects.map((p) => (
              <div class="flex flex-col min-h-48 p-4 backdrop-blur transition-shadow shadow-lg hover:shadow-white/15 bg-white/15 border-2 border-white/20 rounded-lg">
                <h3 class="font-bold text-xl">{p.name}</h3>
                <p class="mb-2">{p.description}</p>
                <div class="flex gap-2 mb-auto">
                  {p.links.map((l) => (
                    <a href={l.href} class="font-bold hover:underline">
                      {l.name}
                    </a>
                  ))}
                </div>
                <div class="flex flex-wrap gap-2">
                  {p.tags.map((t) => (
                    <span class="rounded-full bg-white/40 px-2 py-0.5 text-sm">{t}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <footer class="text-center pb-16">
        <p class="text-neutral-600 dark:text-neutral-400 transition-colors">
          &copy; 2026 Kirill Siukhin. All rights reserved.
        </p>
      </footer>
    </main>
  </AnimatedGradient>
</Layout>
