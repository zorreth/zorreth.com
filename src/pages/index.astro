---
import Layout from '../layouts/Layout.astro';

const donationAddress = 'UQBO8_Di1JEOQRxE2t-Wjy4QNF5cHg-bRnrlAmVUBLlrZPVC';

const links = [
  { name: 'telegram', url: 'https://t.me/zorreth' },
  { name: 'github', url: 'https://github.com/zorreth' },
  { name: 'discord', url: 'https://discord.com/users/1006899291824078858' },
];

const projects = [
  {
    name: 'cube.zorreth.com (in-dev)',
    description: 'speedcubing timer, social platform and progress tracker',
    repo: 'https://github.com/zorreth/cube',
    url: 'https://cube.zorreth.com',
  },
];
---

<Layout title="zorreth">
  <main class="container mx-auto py-8 px-8">
    <section class="flex flex-col gap-2 text-center mb-4">
      <h1 class="font-bold text-6xl tracking-wider">zorreth</h1>
      <p class="text-lg">full-stack dev, photographer, speedcuber, musician</p>
    </section>

    <hr class="border-slate-700 mb-4" />

    <section class="mb-8">
      <h2 class="font-bold text-2xl mb-2">links</h2>
      <div class="flex gap-4">
        {
          links.map(({ name, url }) => (
            <a class="hover:underline hover:font-semibold" href={url}>
              {name}
            </a>
          ))
        }
      </div>
    </section>

    <section class="mb-8">
      <h2 class="font-bold text-2xl mb-2">projects</h2>
      <div class="grid lg:grid-cols-3 gap-4">
        {
          projects.map(({ name, description, repo, url }) => (
            <div class="p-4 bg-slate-900 border border-slate-800">
              {url ? (
                <a href={url} target="_blank" class="hover:underline">
                  <b>{name}</b>
                </a>
              ) : (
                <b>{name}</b>
              )}{' '}
              {repo && (
                <a href={repo} class="hover:underline hover:font-semibold">
                  [repo]
                </a>
              )}{' '}
              – {description}
            </div>
          ))
        }
      </div>
    </section>

    <section class="mb-8">
      <h2 class="font-bold text-2xl mb-2">donate</h2>
      <span>
        TON: <b class="address cursor-pointer" title="Copy" data-address={donationAddress}>
          {donationAddress}
        </b>
      </span>
    </section>

    <hr class="border-slate-700 mb-4" />

    <footer class="text-center">
      &copy; 2026 <b>Kirill Siukhin</b> (aka <b>zorreth</b>)
    </footer>
  </main>
</Layout>

<script>
  const addressText: HTMLSpanElement | null = document.querySelector('.address');

  addressText?.addEventListener('click', () => {
    const address = addressText.dataset.address;

    if (address) {
      navigator.clipboard.writeText(address);
      addressText.innerText = 'Copied! <3';

      setTimeout(() => {
        addressText.innerText = address;
      }, 1500);
    }
  });
</script>
