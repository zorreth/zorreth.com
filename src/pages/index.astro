---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<Layout title="zorreth">
  <header class="container mx-auto flex justify-between items-center py-4">
    <a href="/" class="transition hover:scale-105 active:scale-95 text-4xl font-caveat">
      zorreth
    </a>
    <ThemeToggle />
  </header>

  <main class="transition duration-500 ease-in-out blur-md scale-90">
    <section class="container mx-auto my-24 text-center" id="about">
      <h1 class="text-black dark:text-white font-bold text-2xl md:text-4xl transition-colors p-4">
        Hi there! My name is Kirill
      </h1>
      <p class="text-black dark:text-white text-xl transition-colors p-4">
        I enjoy development, music listening/making, speedcubing and photography.
      </p>
    </section>

    <footer class="text-center">
      <p class="text-neutral-600 dark:text-neutral-400 transition-colors">
        &copy; 2026 Kirill Siukhin. All rights reserved.
      </p>
    </footer>
  </main>
</Layout>

<script>
  const main = document.querySelector('main');

  window.addEventListener('themechange', () => {
    main?.classList.add('blur-md', 'opacity-70', 'scale-95');

    setTimeout(() => {
      main?.classList.remove('blur-md', 'opacity-70', 'scale-95');
    }, 300);
  });

  requestAnimationFrame(() => {
    main?.classList.remove('blur-md', 'scale-90');
  });
</script>
