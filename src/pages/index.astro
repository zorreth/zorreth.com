---
import Layout from '../layouts/Layout.astro';
import { ChevronRight, Moon, Sun } from '@lucide/astro';

const links = [
  {
    name: 'About',
    href: '#about',
  },
  {
    name: 'Projects',
    href: '#projects',
  },
  {
    name: 'Music',
    href: '#music',
  },
];
---

<Layout title="zorreth">
  <div id="tsparticles"></div>

  <main class="transition-all duration-500 ease-in-out">
    <header class="flex items-center justify-center gap-2 mt-4">
      <button
        class="bg-neutral-400 transition-all duration-500 hover:scale-110 active:scale-90 p-4 rounded-full group"
        data-theme-button
      >
        <Moon class="hidden dark:block" />
        <Sun class="block dark:hidden" />
      </button>

      <nav class="bg-neutral-400 p-2 rounded-full flex gap-2">
        {
          links.map(({ name, href }) => (
            <a href={href} class="transition-colors duration-300 rounded-full py-2 px-4">
              {name}
            </a>
          ))
        }
      </nav>

      <a
        href="#contact"
        class="flex items-center transition-colors duration-300 gap-2 w-fit p-4 px-6 rounded-full"
      >
        Contact Me <ChevronRight />
      </a>
    </header>

    <div class="container mx-auto my-32" id="about">
      <h1 class="font-bold text-4xl bg-neutral-900/50 w-fit p-4 rounded-full mb-4">
        Hi! My name is Kirill.
      </h1>
      <p class="font-bold text-xl bg-neutral-900/50 w-fit p-4 rounded-full mb-4">
        I am a full-stack developer, photographer, speedcuber, and musician.
      </p>
    </div>
  </main>
</Layout>

<script>
  import { tsParticles, type ILoadParams } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';
  import { CustomCursor } from 'mouse-animations';

  await loadSlim(tsParticles);

  function getParticleOptions(color: string): ILoadParams {
    return {
      id: 'tsparticles',
      options: {
        fpsLimit: 60,
        fullScreen: {
          enable: true,
          zIndex: -1,
        },
        particles: {
          paint: { fill: { color: { value: color } } },
          number: { value: 80, density: { enable: true } },
          shape: { type: 'circle' },
          opacity: { value: { min: 0.1, max: 0.6 } },
          size: { value: { min: 1, max: 4 } },
          links: {
            enable: true,
            distance: 150,
            opacity: 0.4,
            width: 1,
            color: color,
          },
          move: {
            enable: true,
            speed: 0.3,
            direction: 'none',
            random: true,
            outModes: { default: 'bounce' },
          },
        },
        interactivity: {
          events: {
            onHover: {
              enable: true,
              mode: ['bubble', 'slow', 'grab'],
            },
          },
          modes: {
            bubble: {
              distance: 200,
              size: 6,
              opacity: 1,
              duration: 2,
              mix: false,
            },
            slow: {
              factor: 0.5,
              radius: 200,
            },
            grab: {
              distance: 200,
              links: {
                enable: true,
                opacity: 0.6,
                width: 1,
                color: color,
              },
            },
          },
        },
      },
    };
  }

  const isDark = document.documentElement.classList.contains('dark');
  const initialThemeColor = isDark ? '#ffffff' : '#000000';

  let particlesInstance = await tsParticles.load(getParticleOptions(initialThemeColor));

  let cursor = new CustomCursor({
    innerSize: 6,
    outerSize: 36,
    smoothness: 0.15,
    innerColor: initialThemeColor,
    outerColor: initialThemeColor,
  });

  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-button]');

  themeButton?.addEventListener('click', async () => {
    const main = document.querySelector('main');
    main?.classList.add('blur-md', 'opacity-70', 'scale-95');

    const isDarkNow = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDarkNow ? 'dark' : 'light');

    const newColor = isDarkNow ? '#ffffff' : '#000000';

    if (particlesInstance) {
      particlesInstance.destroy();
      particlesInstance = await tsParticles.load(getParticleOptions(newColor));
    }

    cursor.destroy();

    cursor = new CustomCursor({
      innerSize: 6,
      outerSize: 36,
      smoothness: 0.15,
      innerColor: newColor,
      outerColor: newColor,
    });

    setTimeout(() => {
      main?.classList.remove('blur-md', 'opacity-70', 'scale-95');
    }, 300);
  });
</script>
