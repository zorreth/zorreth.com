---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import AnimatedGradient from '../components/AnimatedGradient.astro';

import TelegramIcon from '../components/icons/TelegramIcon.astro';
import DiscordIcon from '../components/icons/DiscordIcon.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';

const links = [
  {
    name: 'Telegram',
    href: 'https://t.me/zorreth',
    bg: '#0088cc',
    fg: '#fff',
    icon: TelegramIcon,
  },
  {
    name: 'Discord',
    href: 'https://discord.com/users/1006899291824078858',
    bg: '#5865f2',
    fg: '#fff',
    icon: DiscordIcon,
  },
  {
    name: 'GitHub',
    href: 'https://github.com/zorreth',
    bg: '#000',
    fg: '#fff',
    icon: GitHubIcon,
  },
];
---

<Layout title="zorreth">
  <AnimatedGradient>
    <header class="container mx-auto flex justify-between items-center p-4">
      <a href="/" class="transition hover:scale-105 active:scale-95 text-4xl font-display">
        zorreth
      </a>
      <ThemeToggle />
    </header>

    <main class="transition duration-500 ease-in-out">
      <section class="container mx-auto my-12 text-center" id="about">
        <h1
          class="text-neutral-800 dark:text-white font-bold text-2xl md:text-4xl transition-colors p-4"
        >
          Hi there! My name is Kirill
        </h1>
        <p class="text-neutral-800 dark:text-white text-xl transition-colors p-4">
          I enjoy development, music, speedcubing and photography
        </p>
      </section>

      <section class="flex flex-col items-center mb-24 gap-4">
        {
          links.map((link) => {
            const Icon = link.icon;

            return (
              <a
                href={link.href}
                style={`background-color: ${link.bg}; color: ${link.fg};`}
                class="relative text-center text-neutral-800 p-3 rounded-full w-80 font-bold transition shadow hover:scale-105 active:scale-95"
              >
                <Icon class="absolute" />
                {link.name}
              </a>
            );
          })
        }
      </section>

      <footer class="text-center">
        <p class="text-neutral-600 dark:text-neutral-400 transition-colors">
          &copy; 2026 Kirill Siukhin. All rights reserved.
        </p>
      </footer>
    </main>
  </AnimatedGradient>
</Layout>
