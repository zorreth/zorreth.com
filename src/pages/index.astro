---
import Layout from '../layouts/Layout.astro';
import { ChevronRight, Moon } from '@lucide/astro';

const links = [
  {
    name: 'About',
    href: '#about',
  },
  {
    name: 'Projects',
    href: '#projects',
  },
  {
    name: 'Music',
    href: '#music',
  },
];
---

<Layout title="zorreth">
  <div id="tsparticles"></div>

  <header class="flex items-center justify-center gap-2 mt-4">
    <button class="bg-neutral-900/80 hover:bg-cyan-200/50 transition-colors p-4 rounded-full">
      <Moon fill="white" />
    </button>

    <nav class="bg-neutral-900/80 p-2 rounded-full flex gap-2">
      {
        links.map(({ name, href }) => (
          <a href={href} class="hover:bg-cyan-200/50 transition-colors rounded-full py-2 px-4">
            {name}
          </a>
        ))
      }
    </nav>

    <a
      href="#contact"
      class="relative flex items-center transition-all gap-1 hover:gap-2 hover:text-cyan-200 w-fit bg-neutral-900/80 p-4 px-6 rounded-full"
    >
      Contact Me <ChevronRight />
    </a>
  </header>

  <div class="container mx-auto my-48" id="about">
    <h1 class="font-bold text-4xl bg-neutral-900/50 w-fit p-4 rounded-full mb-4">
      Hi! My name is Kirill.
    </h1>
    <p class="font-bold text-xl bg-neutral-900/50 w-fit p-4 rounded-full mb-4">
      I am a full-stack developer, photographer, speedcuber, and musician.
    </p>
  </div>
</Layout>

<script>
  import { loadAmbientPreset } from '@tsparticles/preset-ambient';
  import { tsParticles } from '@tsparticles/engine';
  import { loadSlim } from '@tsparticles/slim';
  import { CustomCursor } from 'mouse-animations';

  await loadAmbientPreset(tsParticles);
  await loadSlim(tsParticles);

  await tsParticles.load({
    id: 'tsparticles',
    options: {
      preset: 'ambient',
      fullScreen: {
        enable: true,
        zIndex: -1,
      },
      interactivity: {
        events: {
          onHover: {
            enable: true,
            mode: ['bubble', 'slow', 'grab'],
          },
        },
        modes: {
          bubble: {
            distance: 200,
            size: 6,
            opacity: 1,
            duration: 2,
            mix: false,
          },
          slow: {
            factor: 3,
            radius: 200,
          },
          grab: {
            distance: 200,
            links: {
              opacity: 0.1,
              color: '#ffffff',
              width: 1,
            },
          },
        },
      },
    },
  });

  new CustomCursor({
    innerSize: 6,
    outerSize: 36,
    innerColor: '#34d399',
    outerColor: 'rgba(52,211,153,0.30)',
    smoothness: 0.15,
  });
</script>
