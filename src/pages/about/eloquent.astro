---
import { Font, Image } from 'astro:assets';
import eloquent from '../../assets/eloquent.png';
import '../../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Font cssVariable="--font-fira-code" />
    <title>Eloquent</title>
  </head>

  <body
    class="text-white bg-stone-950 antialiased flex flex-col items-center justify-center h-screen gap-8 font-mono"
  >
    <a href="https://modrinth.com/mod/eloquent">
      <Image
        src={eloquent}
        alt="Eloquent logo"
        loading="eager"
        width={300}
        height={300}
        class="transition hover:scale-105 rounded-4xl"
      />
    </a>

    <span class="font-bold text-lg">There will be a homepage for Eloquent soon.</span>
  </body>
</html>
