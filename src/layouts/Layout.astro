---
import '../styles/global.css';

import { Font } from 'astro:assets';

const { title } = Astro.props;
---

<html lang="en" class="dark h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="I'm zorreth, and here you can find my links." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-dm-sans" />
    <Font cssVariable="--font-faster-one" />
    <title>{title}</title>

    <script is:inline>
      const localTheme = localStorage.getItem('theme');

      if (localTheme && localTheme === 'light') {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="text-black dark:text-white antialiased">
    <slot />
  </body>
</html>
